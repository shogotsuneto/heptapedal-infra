# Copy to .envrc, fill in, then `direnv allow`. .envrc is gitignored.

# DigitalOcean API token. Scopes are listed in terraform/bootstrap/README.md —
# not Full Access.
export DIGITALOCEAN_TOKEN=""

# Two Spaces keys, with different jobs. See terraform/bootstrap/README.md.
#
# SPACES_* — a full-access key, read by the digitalocean provider. Only a
# full-access key can create a bucket or set its versioning and lifecycle
# configuration, so this is what `terraform/bootstrap` applies with. Needed
# roughly never; leave it out of CI.
export SPACES_ACCESS_KEY_ID=""
export SPACES_SECRET_ACCESS_KEY=""

# AWS_* — a Limited Access key granting Read/Write/Delete on the state bucket
# and nothing else, read by the s3 backend. Used by every stack locally, and by
# CI on apply — planning is local now (ADR 0015). Scoped so that the credential which lives in GitHub Actions
# secrets reaches one bucket rather than the account. Create it by hand after
# the bucket exists.
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""

# Grafana Cloud, read only by `terraform/grafana`. A service account token —
# Administration → Users and access → Service accounts — carrying three fixed
# roles rather than Admin: `alerting.provisioning:writer` (the provider writes
# through the provisioning API, which ordinary alerting roles do not cover),
# `folders:writer`, `datasources:reader`. See terraform/grafana/README.md.
export GRAFANA_AUTH=""

# Synthetic Monitoring has its own API and its own tokens. Synthetics → Config →
# request an API key. No Cloud Access Policy token is needed; the plugin is
# already installed on the stack.
export GRAFANA_SM_ACCESS_TOKEN=""

# The stack slug is the first label of https://<slug>.grafana.net. It also
# derives the data source names the alerts and dashboards query.
export TF_VAR_grafana_stack_slug=""

# Where alerts go. The variable has no default in the configuration on purpose:
# a committed one would be an address on an indexed page (ADR 0012).
export TF_VAR_alert_email=""

# kubectl, helm and kubeseal read only this repository's cluster, whatever
# ~/.kube/config's current context is pointing at for other projects. The file
# holds this one context and nothing else, so `kubectl config use-context`
# cannot wander off to another cluster from here.
#
# Gitignored (`kubeconfig`). It carries no credential: the user entry runs
# `doctl kubernetes cluster kubeconfig exec-credential`, which fetches a
# short-lived token through doctl's own auth. Create or refresh it, after
# `direnv allow` so that KUBECONFIG already points here, with
#
#   (umask 077; doctl kubernetes cluster kubeconfig save heptapedal)
#
# `save` writes into $KUBECONFIG and leaves ~/.kube/config alone. Not `show`:
# that prints a kubeconfig with a bearer token embedded in it. Needed again only
# when the cluster is replaced (docs/rebuild.md).
export KUBECONFIG="$PWD/kubeconfig"
