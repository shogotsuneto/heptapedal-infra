# Copy to .envrc, fill in, then `direnv allow`. .envrc is gitignored.

# DigitalOcean API token. Creates and manages every resource.
export DIGITALOCEAN_TOKEN=""

# Spaces access key, created by hand in the control panel — see
# terraform/bootstrap/README.md for why it is not a Terraform resource.
#
# The same key pair is needed twice, under two names: the digitalocean provider
# reads SPACES_*, and the s3 backend reads AWS_*. Setting only one pair fails in
# a confusing way, so the aliases below are deliberate.
export SPACES_ACCESS_KEY_ID=""
export SPACES_SECRET_ACCESS_KEY=""
export AWS_ACCESS_KEY_ID="${SPACES_ACCESS_KEY_ID}"
export AWS_SECRET_ACCESS_KEY="${SPACES_SECRET_ACCESS_KEY}"
