# Local planning notes and scratch context — never published.
# Previously only in .git/info/exclude, which is local-only and travels with
# neither a clone nor a collaborator. See ADR 0012.
excluded.d/

# Terraform / OpenTofu state holds every resource attribute in plaintext,
# including values marked sensitive. It lives in Spaces (ADR 0003), never here.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log

# Variable files routinely carry tokens and connection strings.
*.tfvars
*.tfvars.json
!example.tfvars

# Local-only configuration overrides. OpenTofu merges these over the main
# configuration automatically, which is how bootstrap swaps the backend for its
# first apply (see terraform/bootstrap/README.md).
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan artifacts are as sensitive as state.
*.tfplan
plan.out
plan.json

# Credentials and kubeconfigs. .mcp.json carries a personal access token in an
# Authorization header — it configures this project's MCP client, so it belongs
# in the working tree but never in a commit.
.mcp.json
kubeconfig
kubeconfig.*
*.pem
*.key
.env
.envrc

# Unsealed secret material, staged before `kubeseal`.
*-unsealed.yaml
secret-*.yaml
!sealed-*.yaml

.DS_Store
