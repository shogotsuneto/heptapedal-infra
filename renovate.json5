{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    // Wait for a version to have been out a few days. Nothing here is urgent,
    // and a released-then-yanked chart is a real thing.
    "config:best-practices",
  ],

  // `config:best-practices` also pins to digests, which does not suit this
  // repository in either place it applies.
  //
  // For actions it is unreachable: GITHUB_TOKEN cannot write
  // .github/workflows/, so the pin pull request can never be pushed. Left on,
  // it sits on the dependency dashboard permanently as an approval that always
  // fails — a to-do nobody can clear. It would also change bumping actions from
  // a yearly edit to one per release, which is a poor pairing with having
  // chosen to bump them by hand.
  //
  // For images it is reachable, and declined for readability: a digest beside
  // the tag is noise in a manifest people read, and it adds a pull request every
  // time the same tag is rebuilt. The tag is already an immutable release from a
  // known publisher, which is the property ADR 0011 asks for.
  pinDigests: false,

  // Weekly rather than daily. Pins here rot over months, not hours, and a bot
  // that opens something every morning is a bot people stop reading.
  schedule: ["before 6am on Monday"],
  timezone: "America/Vancouver",

  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Argo CD Application manifests have no naming convention, so Renovate
  // matches none of them unless told where they are.
  argocd: {
    managerFilePatterns: ["/^gitops/.+\\.yaml$/"],
  },

  // Container images inside plain Kubernetes manifests — the keepalive CronJob.
  kubernetes: {
    managerFilePatterns: ["/^gitops/.+\\.yaml$/"],
  },

  packageRules: [
    {
      // Our own charts are deliberately out of scope. Their release timing is
      // ours and already deliberate — 0.2.0, 0.2.1 and 0.2.2 were each bumped
      // here on purpose, with a reason — so a suggestion adds nothing. Leaving
      // them out also means Renovate needs no GHCR credential, and the token
      // #10 sealed into the cluster gains no third copy.
      matchPackageNames: [
        "ghcr.io/shogotsuneto/charts/heptapedal-app",
        "ghcr.io/shogotsuneto/charts/heptapedal-embeddings",
      ],
      enabled: false,
    },
    {
      // The point of the whole exercise: third-party charts, which nobody here
      // is watching.
      matchManagers: ["argocd"],
      groupName: "platform charts",
      // Kept separate from the group so a chart's own release notes are read
      // rather than skimmed as one of five.
      separateMinorPatch: true,
    },
    {
      // Detected, listed, never opened. GITHUB_TOKEN may not write files under
      // .github/workflows/ — there is no `workflows` scope in a workflow's
      // `permissions:` block to grant — so Renovate would build the branch and
      // fail to push it, every week, until someone intervened.
      //
      // Approval-gated instead: the update appears on the dependency dashboard
      // and nothing is attempted. That keeps the one thing worth keeping, which
      // is being told an action moved; the edit itself is three files and no
      // judgement.
      //
      // Do not tick the checkbox — though the cost of doing so is small and
      // worth knowing rather than fearing. Ticking edits the issue and starts
      // nothing; the next run reads the body, sees the approval, tries, and
      // fails to push. Renovate rewrites the dashboard each run, so the tick is
      // consumed and it does not retry. One failed run, not a loop.
      //
      // Bump the version by hand instead, and the entry disappears on the next
      // run because the update is no longer pending.
      matchManagers: ["github-actions"],
      dependencyDashboardApproval: true,
      groupName: "github actions",
    },
    {
      matchManagers: ["terraform"],
      groupName: "terraform providers",
    },
    {
      // Patches to things that cannot break a running cluster. Batched, because
      // reviewing them one at a time is how a bot becomes noise. Actions are
      // absent here deliberately — they are dashboard-only above, and grouping
      // them into a pull request that cannot be pushed would defeat that.
      matchManagers: ["terraform"],
      matchUpdateTypes: ["patch"],
      groupName: "patch updates",
      automerge: false,
    },
  ],

  // Where a chart pins an appVersion, say so in the PR body — the chart bump is
  // rarely the change that matters.
  commitMessagePrefix: "chore(deps):",
}
