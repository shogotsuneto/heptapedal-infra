{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // `config:best-practices` was here, and it brought more than it said. It is
  // config:recommended plus docker:pinDigests, helpers:pinGitHubActionDigests,
  // :configMigration, :pinDevDependencies, abandonments:recommended,
  // security:minimumReleaseAgeNpm and :maintainLockFilesWeekly — of which two
  // pin digests, two are npm-only and irrelevant here, and one was the reason
  // it was added in the first place.
  //
  // That last one is worth admitting: it was added to "wait a few days before
  // proposing a release", and the preset that does this is
  // security:minimumReleaseAgeNpm, which applies to npm and nothing else. The
  // behaviour was never in effect. It is set properly below.
  extends: [
    "config:recommended",

    // All four .terraform.lock.hcl are committed, so this refreshes provider
    // hashes rather than doing nothing.
    ":maintainLockFilesWeekly",

    // Rewrite deprecated configuration as a pull request instead of warning
    // about it in a log nobody reads.
    ":configMigration",

    // Say when a dependency looks unmaintained. Cheap, and the kind of thing
    // that is otherwise noticed years late.
    "abandonments:recommended",
  ],

  // What the npm-only preset was mistaken for. Nothing here is urgent, and a
  // released-then-yanked chart is a real thing.
  minimumReleaseAge: "3 days",

  // Digest pinning is deliberately absent — see the two presets left out above.
  // Setting `pinDigests: false` here would not have been enough anyway:
  // helpers:pinGitHubActionDigests sets it through a packageRule, and those are
  // applied after top-level options, so the top-level value loses. Not
  // extending the preset is the only thing that actually turns it off.

  // No `schedule` here on purpose. The workflow runs weekly and is the only
  // thing that invokes Renovate, so it *is* the schedule; a second one inside
  // Renovate can only ever agree or disagree with it.
  //
  // It disagreed. The cron fired at 13:00 UTC, which is 06:00 in Vancouver, and
  // `before 6am` is a window that closes at 06:00 — so every scheduled run
  // landed just outside its own schedule and created nothing. GitHub also runs
  // cron late rather than early, which made it worse rather than marginal.
  //
  // One schedule cannot disagree with itself. It also makes a manual run do
  // what running something manually should do: open the pull requests now.

  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Argo CD Application manifests have no naming convention, so Renovate
  // matches none of them unless told where they are.
  argocd: {
    managerFilePatterns: ["/^gitops/.+\\.yaml$/"],
  },

  // Container images inside plain Kubernetes manifests — the keepalive CronJob.
  kubernetes: {
    managerFilePatterns: ["/^gitops/.+\\.yaml$/"],
  },

  packageRules: [
    {
      // Our own charts are deliberately out of scope. Their release timing is
      // ours and already deliberate — 0.2.0, 0.2.1 and 0.2.2 were each bumped
      // here on purpose, with a reason — so a suggestion adds nothing. Leaving
      // them out also means Renovate needs no GHCR credential, and the token
      // #10 sealed into the cluster gains no third copy.
      matchPackageNames: [
        "ghcr.io/shogotsuneto/charts/heptapedal-app",
        "ghcr.io/shogotsuneto/charts/heptapedal-embeddings",
      ],
      enabled: false,
    },
    {
      // The point of the whole exercise: third-party charts, which nobody here
      // is watching.
      matchManagers: ["argocd"],
      groupName: "platform charts",
      // Kept separate from the group so a chart's own release notes are read
      // rather than skimmed as one of five.
      separateMinorPatch: true,
    },
    {
      // Detected, listed, never opened. GITHUB_TOKEN may not write files under
      // .github/workflows/ — there is no `workflows` scope in a workflow's
      // `permissions:` block to grant — so Renovate would build the branch and
      // fail to push it, every week, until someone intervened.
      //
      // Approval-gated instead: the update appears on the dependency dashboard
      // and nothing is attempted. That keeps the one thing worth keeping, which
      // is being told an action moved; the edit itself is three files and no
      // judgement.
      //
      // Do not tick the checkbox — though the cost of doing so is small and
      // worth knowing rather than fearing. Ticking edits the issue and starts
      // nothing; the next run reads the body, sees the approval, tries, and
      // fails to push. Renovate rewrites the dashboard each run, so the tick is
      // consumed and it does not retry. One failed run, not a loop.
      //
      // Bump the version by hand instead, and the entry disappears on the next
      // run because the update is no longer pending.
      matchManagers: ["github-actions"],
      dependencyDashboardApproval: true,
      groupName: "github actions",
    },
    {
      matchManagers: ["terraform"],
      groupName: "terraform providers",
    },
    {
      // Patches to things that cannot break a running cluster. Batched, because
      // reviewing them one at a time is how a bot becomes noise. Actions are
      // absent here deliberately — they are dashboard-only above, and grouping
      // them into a pull request that cannot be pushed would defeat that.
      matchManagers: ["terraform"],
      matchUpdateTypes: ["patch"],
      groupName: "patch updates",
      automerge: false,
    },
  ],

  // Where a chart pins an appVersion, say so in the PR body — the chart bump is
  // rarely the change that matters.
  commitMessagePrefix: "chore(deps):",
}
