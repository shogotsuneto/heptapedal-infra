{
  "uid": "heptapedal-overview",
  "title": "heptapedal",
  "tags": [
    "heptapedal"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Memory against limit",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROMETHEUS_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"hepta\", container=~\"app|embeddings\"})",
          "legendFormat": "{{container}} used"
        },
        {
          "refId": "B",
          "expr": "sum by (container) (kube_pod_container_resource_limits{namespace=\"hepta\", container=~\"app|embeddings\", resource=\"memory\"})",
          "legendFormat": "{{container}} limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (route) (rate({namespace=\"hepta\", container=\"app\"} | json target=\"target\", route=\"span.route\" | target=`hepta::http` [$__auto]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latency, p95 and p50",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {namespace=\"hepta\", container=\"app\"} | json target=\"target\", latency_ms=\"span.latency_ms\" | target=`hepta::http` | unwrap latency_ms [$__auto]) by (container)",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "queryType": "range",
          "expr": "quantile_over_time(0.50, {namespace=\"hepta\", container=\"app\"} | json target=\"target\", latency_ms=\"span.latency_ms\" | target=`hepta::http` | unwrap latency_ms [$__auto]) by (container)",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Responses by status class",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "__LOKI_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (status) (rate({namespace=\"hepta\", container=\"app\"} | json target=\"target\", status=\"span.status\" | target=`hepta::http` [$__auto]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    }
  ]
}
